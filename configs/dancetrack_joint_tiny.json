{
  "model": {
    "name": "microworld_jepa_tiny",
    "latent_dim": 64,
    "observation_dim": 256,
    "appearance_dim": 32,
    "graph_hidden_dim": 96,
    "graph_layers": 2,
    "num_neighbors": 6,
    "motion_modes": 3,
    "rollout_horizon": 3,
    "max_hypotheses": 4,
    "camera_dim": 6,
    "dropout": 0.05
  },
  "data": {
    "kind": "joint_raw",
    "train_paths": [
      "data/raw/DanceTrack/train1",
      "data/raw/DanceTrack/train2"
    ],
    "val_paths": [
      "data/raw/DanceTrack/val"
    ],
    "raw_format": "mot",
    "image_size": 640,
    "sequence_length": 4,
    "stride": 4,
    "temporal_intervals": [1, 2, 4],
    "min_track_frames": 2,
    "max_tracks": 64,
    "max_detections": 128,
    "gt_classes": [1],
    "num_workers": 4,
    "balance_datasets": false
  },
  "train": {
    "epochs": 60,
    "batch_size": 1,
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "gradient_clip": 1.0,
    "seed": 7,
    "device": "cuda:0",
    "amp": true,
    "output_dir": "outputs/dancetrack_joint_tiny",
    "resume": "",
    "target_ema_decay": 0.996,
    "gradient_accumulation": 4,
    "detach_interval": 2,
    "log_interval": 20
  },
  "joint": {
    "enabled": true,
    "detector_weights": "yolo11n.pt",
    "detector_backbone_lr": 0.00001,
    "detector_head_lr": 0.00005,
    "perception_lr": 0.0001,
    "world_lr": 0.0003,
    "detector_loss_weight": 1.0,
    "world_loss_weight": 1.0,
    "association_temperature": 0.1,
    "sinkhorn_iterations": 8,
    "roi_size": 3,
    "world_prior_strength": 0.1
  },
  "loss": {
    "state": 1.0,
    "rollout": 0.5,
    "association": 1.0,
    "counterfactual": 0.0,
    "identity": 0.25,
    "existence": 0.25,
    "occlusion": 0.25,
    "uncertainty": 0.1,
    "refresh": 0.1,
    "object_jepa": 0.5,
    "object_jepa_rollout": 0.0,
    "counterfactual_margin": 0.05
  }
}
